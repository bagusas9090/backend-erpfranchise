{
  "openapi": "3.0.0",
  "info": {
    "title": "User Management API",
    "description": "Dokumentasi API untuk manajemen user, registrasi, login, update profile, dan logout.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8000/api",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/users": {
      "post": {
        "summary": "Register new user",
        "description": "Endpoint untuk mendaftarkan user baru ke dalam sistem.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password",
                  "name"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "minLength": 5,
                    "maxLength": 100,
                    "example": "bagusas"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 5,
                    "maxLength": 100,
                    "example": "rahasia123"
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 100,
                    "example": "Bagus Ari"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User berhasil terdaftar",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "username": {
                          "type": "string",
                          "example": "bagusas"
                        },
                        "name": {
                          "type": "string",
                          "example": "Bagus Ari"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Username sudah terdaftar atau input tidak valid",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errors": {
                      "type": "object",
                      "properties": {
                        "username": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "example": [
                            "username already exists"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/users/login": {
      "post": {
        "summary": "User login",
        "description": "Endpoint untuk melakukan autentikasi user dan mendapatkan token akses.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "bagusas"
                  },
                  "password": {
                    "type": "string",
                    "example": "rahasia123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login sukses",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "username": {
                          "type": "string",
                          "example": "bagusas"
                        },
                        "name": {
                          "type": "string",
                          "example": "Bagus Ari"
                        },
                        "token": {
                          "type": "string",
                          "example": "random-token-string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Username atau password salah",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errors": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "username or password wrong"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/users/current": {
      "get": {
        "summary": "Get current user profile",
        "description": "Endpoint untuk mengambil data profil user yang sedang login.",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Berhasil mendapatkan data user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "username": {
                          "type": "string",
                          "example": "bagusas"
                        },
                        "name": {
                          "type": "string",
                          "example": "Bagus Ari"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized / Token tidak valid atau tidak disediakan",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errors": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Unauthorized"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Update user profile",
        "description": "Endpoint untuk memperbarui data profile user (nama atau password).",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 100,
                    "example": "Bagus Ari Wibowo"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 5,
                    "maxLength": 100,
                    "example": "baru123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile berhasil diperbarui",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "username": {
                          "type": "string",
                          "example": "bagusas"
                        },
                        "name": {
                          "type": "string",
                          "example": "Bagus Ari Wibowo"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errors": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Unauthorized"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/users/logout": {
      "delete": {
        "summary": "User logout",
        "description": "Endpoint untuk melakukan logout dan menghapus token akses.",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Logout sukses",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errors": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Unauthorized"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Gunakan token autentikasi (format custom atau Bearer)."
      }
    }
  }
}
